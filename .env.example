NODE_ENV=development
PORT=4001
POSTGRES_USER=lingospeak
POSTGRES_PASSWORD=lingospeak
POSTGRES_DB=lingospeak
DATABASE_URL=postgresql://lingospeak:lingospeak@localhost:5432/lingospeak?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-this-access-secret-to-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-to-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=120
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_RECENT_REQUEST_WINDOW_SECONDS=600
AUTH_OTP_HOURLY_WINDOW_SECONDS=3600
AUTH_OTP_HOURLY_LIMIT=5
AUTH_OTP_ATTEMPT_LIMIT=5
GOOGLE_CLIENT_ID=
WEB_URL=http://localhost:3000
API_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4001/api
NEXT_PUBLIC_S3_ORIGIN=http://localhost:9000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_PHONE=021 9109 4200
NEXT_PUBLIC_CONTACT_EMAIL=support@lingospeak.ir
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LOCALE_COOKIE_MAX_AGE_SECONDS=31536000
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_SERVER_TIMEOUT_MS=120000
LOAD_API_URL=http://localhost:4001/api
SOAK_SECONDS=7200
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
S3_BUCKET=lingospeak
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
FILE_MAX_UPLOAD_BYTES=52428800
FILE_UPLOAD_URL_TTL_SECONDS=600
FILE_DOWNLOAD_URL_TTL_SECONDS=300
# Deadline for every outbound call to a third party (Google, Zarinpal,
# Kavenegar). A provider that accepts the connection and never answers would
# otherwise hold an API worker open indefinitely.
PROVIDER_TIMEOUT_MS=10000
HEALTH_CHECK_TIMEOUT_MS=2000
DASHBOARD_STATS_RECONCILIATION_INTERVAL_MS=600000
SERVICE_NAME=lingospeak-api
LOG_LEVEL=debug
LOG_PRETTY=true
LOG_HTTP=true
LOG_HEALTH_REQUESTS=false
# Local development only. Fixes every OTP at 123456 and echoes it back in the
# API response so you can sign in without an SMS provider. The API refuses to
# start if this is left on with NODE_ENV=production. Turn it off and set
# KAVENEGAR_API_KEY for any shared or deployed environment.
AUTH_DEV_OTP=true
# Number of reverse proxies in front of the API. Per-IP rate limiting is only
# accurate when this matches the deployment: 0 for direct exposure, 1 behind a
# single nginx/load balancer. Too high and clients can spoof X-Forwarded-For.
TRUST_PROXY=0
# Provider credentials. Optional in development, REQUIRED when
# NODE_ENV=production — the API refuses to start without them, because each one
# silently falls back to a development adapter that must never run in
# production: without ZARINPAL_MERCHANT_ID the gateway treats any `dev_`
# authority as a verified capture, and without KAVENEGAR_API_KEY no OTP or
# reminder SMS is ever delivered.
#
# KAVENEGAR_API_KEY must belong to a *service* line (خط خدماتی), not an
# advertising line, or OTP codes will not reach numbers that have opted out of
# promotional SMS. The API uses the verify/lookup template endpoint, which is the
# service-line API; the `lingospeak-otp` and `lingospeak-reminder` templates must
# exist in the Kavenegar panel.
KAVENEGAR_API_KEY=
KAVENEGAR_API_BASE=https://api.kavenegar.com
KAVENEGAR_OTP_TEMPLATE=lingospeak-otp
KAVENEGAR_REMINDER_TEMPLATE=lingospeak-reminder
KAVENEGAR_SUPPORT_TEMPLATE=lingospeak-ticket
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX_MERCHANT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
ZARINPAL_API_BASE=https://payment.zarinpal.com
ZARINPAL_START_BASE=https://payment.zarinpal.com
ZARINPAL_SANDBOX_API_BASE=https://sandbox.zarinpal.com
ZARINPAL_SANDBOX_START_BASE=https://sandbox.zarinpal.com
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_MINIMUM_AGE_MS=120000
PAYMENT_RECONCILIATION_RETRY_AFTER_MS=600000
PAYMENT_RECONCILIATION_BATCH_SIZE=100
# Use Zarinpal's isolated test endpoints locally. Production validation rejects it.
ZARINPAL_SANDBOX=true
# Enamad (اعتماد) e-trust seal snippet, required to take payments in Iran.
# Paste the HTML that the Enamad panel issues for this exact domain; the footer
# renders it verbatim and shows nothing at all while this is empty. Inlined at
# build time, so the web app needs a REBUILD after setting it, not a restart.
NEXT_PUBLIC_ENAMAD_HTML=
