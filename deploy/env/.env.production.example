# ---------------------------------------------------------------------------
# نمونه‌ی env تولیدی لینگواسپیک.
#
# این فایل را در سرور به /home/deploy/lingospeak/env/app.env کپی کن، مقادیر
# علامت‌خورده با «⟨تولید کن⟩» را پر کن، و مود را ۶۰۰ بگذار:
#     cp .env.production.example app.env && chmod 600 app.env
#
# ‏deploy.sh env قبل از هر کار دیگری این فایل را اعتبارسنجی می‌کند.
#
# دو نکته که وقت زیادی می‌گیرند اگر ندانی:
#   ۱. متغیرهای NEXT_PUBLIC_* در زمان **build** داخل باندل جاسازی می‌شوند.
#      عوض کردنشان اینجا بدون rebuild ایمیج وب هیچ اثری ندارد.
#   ۲. این فایل درون‌یابی متغیر ندارد. DATABASE_URL باید رمز را عیناً و
#      کامل بنویسد، نه ${POSTGRES_PASSWORD}.
# ---------------------------------------------------------------------------

# ── هسته ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001

# پشت Caddy دقیقاً یک پراکسی وجود دارد.
# ‏env.validation.ts:114-120: محدودیت نرخ per-IP از request.ip می‌خواند، که
# فقط وقتی IP واقعی کاربر را نشان می‌دهد که Express بداند چند hop از
# X-Forwarded-For قابل اعتماد است. با 0 (پیش‌فرض) کل اینترنت در یک سطل
# مشترک می‌افتد و محدودیت auth عملاً از بین می‌رود؛ با عددی بزرگ‌تر از
# توپولوژی واقعی، کلاینت می‌تواند هدر را جعل کند.
TRUST_PROXY=1

# ── دیتابیس ───────────────────────────────────────────────────────────────
POSTGRES_USER=lingospeak
POSTGRES_DB=lingospeak
# ⟨تولید کن⟩  openssl rand -hex 24
# عمداً hex و نه base64: کاراکترهای + / = در base64 باید در DATABASE_URL
# درصد-انکد شوند و این جای رایجی برای خطاست.
POSTGRES_PASSWORD=dMjKPqlcSiKPD8cqthIIKF9kQYQQxADhfrgOfqQEp0

# ⟨تولید کن⟩ همان رمز بالا را اینجا هم بگذار. میزبان `postgres` نام سرویس
# در شبکه‌ی داخلی compose است.
DATABASE_URL=postgresql://lingospeak:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/lingospeak?schema=public

REDIS_URL=redis://redis:6379

# ── نشانی‌ها ──────────────────────────────────────────────────────────────
WEB_URL=https://lingospeak.org
# بدون /api — کد خودش اضافه می‌کند:
# payments.service.ts:298 → `${API_URL}/api/payments/callback`
API_URL=https://lingospeak.org

# ── JWT ───────────────────────────────────────────────────────────────────
# ⟨تولید کن⟩  openssl rand -base64 48
# باید حداقل ۳۲ کاراکتر باشند و **با هم فرق کنند**.
# ‏JWT_ACCESS_SECRET دو کار می‌کند: امضای توکن دسترسی، و مشتق‌کردن فلفلِ
# ‏HMAC که کدهای OTP با آن هش می‌شوند. عوض کردنش همه‌ی نشست‌ها و OTP های
# در جریان را باطل می‌کند.
JWT_ACCESS_SECRET=tRRoOFZ/BBPTws4heZhhq91zKBkqvcgGzkh6fg6YZP8a3r+yjUINee8D2DFruGkp
JWT_REFRESH_SECRET=k2VAtG7cvQOkyfx6hy1JnW+jV5vaaSuALEKY8qcuKtqwRlwbBwW3/qzknE805UOL

JWT_ACCESS_TTL=15m
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── OTP ───────────────────────────────────────────────────────────────────
AUTH_OTP_TTL_SECONDS=120
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_RECENT_REQUEST_WINDOW_SECONDS=600
AUTH_OTP_HOURLY_WINDOW_SECONDS=3600
AUTH_OTP_HOURLY_LIMIT=10
AUTH_OTP_ATTEMPT_LIMIT=5

# ⚠ AUTH_DEV_OTP عمداً در این فایل **نیست**.
#   با NODE_ENV=production حضورش با مقدار true باعث می‌شود API اصلاً بالا
#   نیاید (env.validation.ts:124). حتی false هم ننویس — نبودنش امن‌ترین حالت
#   است چون پیش‌فرضش خاموش است.

# ── ذخیره‌سازی ────────────────────────────────────────────────────────────
# باید نشانی **عمومی** باشد، نه http://minio:9000.
# ‏s3-object-storage.adapter.ts لینک presigned می‌سازد و آن را به مرورگر
# می‌دهد؛ با نشانی داخلی، هر آپلود و دانلود فایل در مرورگر می‌شکند.
# بدون اسلش انتهایی — امضای SigV4 به مسیر حساس است.
S3_ENDPOINT=https://storage.lingospeak.org
# ⟨تولید کن⟩  openssl rand -hex 16
S3_ACCESS_KEY=
# ⟨تولید کن⟩  openssl rand -base64 32
S3_SECRET_KEY=S3_SECRET_KEY=MIULDgjRsPUOcX4ahzLdY6MGQsfXGxlptfxVNefA
S3_BUCKET=lingospeak
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
FILE_MAX_UPLOAD_BYTES=52428800
FILE_UPLOAD_URL_TTL_SECONDS=600
FILE_DOWNLOAD_URL_TTL_SECONDS=300

# ── پیامک (کاوه‌نگار) ─────────────────────────────────────────────────────
# ⟨تهیه کن⟩ با NODE_ENV=production اجباری است — بدونش API بالا نمی‌آید
# (env.validation.ts:150).
# باید کلید یک **خط خدماتی** باشد، نه تبلیغاتی: کد OTP به شماره‌هایی که
# پیامک تبلیغاتی را مسدود کرده‌اند نمی‌رسد. قالب‌های lingospeak-otp و
# lingospeak-reminder باید در پنل کاوه‌نگار از قبل ساخته شده باشند.
KAVENEGAR_API_KEY=
KAVENEGAR_API_BASE=https://api.kavenegar.com
KAVENEGAR_OTP_TEMPLATE=lingospeak-otp
KAVENEGAR_REMINDER_TEMPLATE=lingospeak-reminder
KAVENEGAR_SUPPORT_TEMPLATE=lingospeak-ticket

# ── درگاه پرداخت (زرین‌پال) ───────────────────────────────────────────────
# وضعیت فعلی: اینماد هنوز گرفته نشده، پس مرچنت واقعی هم نیست.
#
# ⟨مقدار موقت⟩ این فیلد باید **ناخالی** باشد وگرنه API بالا نمی‌آید. ولی
# مقدار موقت خطرناک نیست — برعکس، لازم است:
#   • خالی + sandbox=false  → gateway.service.ts:18 یک authority با پیشوند
#     dev_ می‌سازد و verify() آن را **موفق** برمی‌گرداند ⇒ پکیج رایگان.
#   • پرشده + sandbox=false → مسیر واقعی زرین‌پال؛ با مرچنت نامعتبر پاسخ خطا
#     می‌آید و BadGatewayException صادر می‌شود ⇒ هیچ چیز رایگانی داده نمی‌شود.
# مسیرهای شروع پرداخت تا آن موقع در Caddy با ۵۰۳ بسته‌اند.
#
# وقتی مرچنت واقعی رسید: همین خط را عوض کن، بلاک @payment_start را از
# Caddyfile بردار، و api را restart کن. هیچ تغییر کدی لازم نیست.
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# ⚠ روی true نگذار. با NODE_ENV=production باعث می‌شود API بالا نیاید
#   (env.validation.ts:143) — و اگر گارد دور زده شود، پرداخت‌های تستی روی
#   سایت زنده موفق می‌شوند و هر کسی رایگان پکیج می‌گیرد.
ZARINPAL_SANDBOX=false
ZARINPAL_API_BASE=https://payment.zarinpal.com
ZARINPAL_START_BASE=https://payment.zarinpal.com
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_MINIMUM_AGE_MS=120000
PAYMENT_RECONCILIATION_RETRY_AFTER_MS=600000
PAYMENT_RECONCILIATION_BATCH_SIZE=100

# ── ورود با گوگل (اختیاری) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── لاگ و سلامت ───────────────────────────────────────────────────────────
LOG_LEVEL=info
# pretty=false یعنی JSON خطی — قابل خواندن برای هر ابزار لاگ، و بدون هزینه‌ی
# رنگ‌آمیزی روی هر خط.
LOG_PRETTY=false
LOG_HTTP=true
# healthcheck هر ۱۵ ثانیه می‌زند؛ لاگ کردنش فقط نویز است.
LOG_HEALTH_REQUESTS=false
SERVICE_NAME=lingospeak-api
HEALTH_CHECK_TIMEOUT_MS=2000
PROVIDER_TIMEOUT_MS=10000
DASHBOARD_STATS_RECONCILIATION_INTERVAL_MS=600000

# ── متغیرهای build وب (NEXT_PUBLIC_*) ─────────────────────────────────────
# ⚠ اینها در زمان build خوانده می‌شوند نه زمان اجرا. هر تغییری اینجا نیازمند
#   `deploy.sh build` دوباره است، نه restart.
NEXT_PUBLIC_API_URL=https://lingospeak.org/api
NEXT_PUBLIC_WEB_URL=https://lingospeak.org
# باید با S3_ENDPOINT یکی باشد: middleware.ts این مقدار را در
# connect-src/img-src/media-src هدر CSP می‌گذارد. اگر با نشانی واقعی فایل‌ها
# فرق کند، مرورگر آپلود و نمایش تصویر را بلاک می‌کند.
NEXT_PUBLIC_S3_ORIGIN=https://storage.lingospeak.org
NEXT_PUBLIC_CONTACT_PHONE=021 9109 4200
NEXT_PUBLIC_CONTACT_EMAIL=support@lingospeak.org
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LOCALE_COOKIE_MAX_AGE_SECONDS=31536000
# ⟨بعد از اینماد⟩ کد HTML ای که پنل اعتماد برای همین دامنه صادر می‌کند.
# فوتر عیناً رندرش می‌کند و تا وقتی خالی است چیزی نشان نمی‌دهد.
# نیازمند **rebuild** وب است، نه restart.
NEXT_PUBLIC_ENAMAD_HTML=
